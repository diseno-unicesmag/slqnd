<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Match Creativo · Sobre lo que no digo</title>
  <link rel="stylesheet" href="css/style.css">
  <style>
    .match-table { width:100%; border-collapse:collapse; }
    .match-table th {
      padding:12px 20px; font-size:11px; letter-spacing:0.1em; text-transform:uppercase;
      color:var(--muted); font-weight:500; text-align:left; border-bottom:1px solid var(--border);
      background:var(--bg3);
    }
    .match-table td { padding:16px 20px; font-size:14px; border-bottom:1px solid rgba(255,255,255,0.04); vertical-align:top; line-height:1.6; }
    .match-table tr:last-child td { border-bottom:none; }
    .match-table tr:hover td { background:rgba(255,255,255,0.02); }
    .match-table td:nth-child(1) { font-weight:500; color:var(--muted2); min-width:180px; }
    .match-table td:nth-child(2) { color:var(--muted2); max-width:320px; font-size:13px; }
    .match-table td:nth-child(3) { font-weight:600; min-width:200px; }
    .match-table td:nth-child(4) { max-width:340px; font-size:13px; color:var(--muted2); }
    .phase-header td { background:var(--bg3); padding:10px 20px; }
    .phase-label { font-size:11px; letter-spacing:0.12em; text-transform:uppercase; font-weight:600; }
    .f1 { color:var(--gold); }
    .f2 { color:var(--blue); }
    .f3 { color:var(--green); }
    td.f1 { color:var(--gold); }
    td.f2 { color:var(--blue); }
    td.f3 { color:var(--green); }
    .arrow { color:var(--muted); font-size:18px; vertical-align:middle; padding:0 8px; }
    .wrap { background:var(--bg2); border:1px solid var(--border); border-radius:var(--radius); overflow:hidden; overflow-x:auto; }
    .vs-col { width:40px; text-align:center; color:var(--muted); font-size:18px; padding:16px 0 !important; }
    .filter-bar { display:flex; gap:10px; margin-bottom:24px; flex-wrap:wrap; }
    .f-btn { padding:7px 16px; border-radius:100px; font-size:12px; cursor:pointer; background:var(--bg3); border:1px solid var(--border); color:var(--muted2); transition:var(--transition); }
    .f-btn.active, .f-btn:hover { color:var(--text); border-color:rgba(255,255,255,0.2); }
  </style>
</head>
<body>
<nav>
  <a class="nav-brand" href="index.html"><em>Sobre lo que no digo</em></a>
  <div class="nav-links">
    <div class="nav-item">
      <button class="nav-link active">Productos <svg viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 1l4 4 4-4"/></svg></button>
      <div class="nav-dropdown">
        <a href="cadena-valor.html">Cadena de valor</a>
        <a href="match-creativo.html" style="color:var(--gold);">Match creativo</a>
        <a href="lluvia-ideas.html">Lluvia de ideas</a>
      </div>
    </div>
    <div class="nav-item">
      <button class="nav-link">Instrumentos <svg viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 1l4 4 4-4"/></svg></button>
      <div class="nav-dropdown">
        <a href="http://localhost:3000/dashboard.html" target="_blank">CDPS</a>
      </div>
    </div>
  </div>
</nav>

<div class="page">
  <div class="page-header">
    <div class="page-header-inner">
      <div class="section-label">Productos · Estrategia creativa</div>
      <h1>Match <em style="color:var(--gold);font-style:italic;">Creativo</em></h1>
      <p>Contraposición entre los productos académicos genéricos y las resoluciones innovadoras, interactivas y transmedia que define el enfoque de este proyecto.</p>
      <div style="margin-top:24px;display:flex;gap:12px;flex-wrap:wrap;">
        <a class="btn btn-gold" href="Recursos/Match Creativo.xlsx" download>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Descargar Excel
        </a>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="wrap">
      <table class="match-table" id="match-table">
        <thead>
          <tr>
            <th>Match creativo . Análisis de productos</th>
            <th>Por qué es genérico</th>
            <th>→ Matriz de ecosistema interactivo</th>
            <th>Descripción</th>
          </tr>
        </thead>
        <tbody id="match-body"></tbody>
      </table>
    </div>
  </div>
</div>

<script>
const MATCH = [
  { fase:'f1', cliche:'Marco teórico', porque:'Es el documento de texto con secciones, citas y bibliografía, y actúa como formato por defecto del marco teórico. Organiza los conceptos pero no permite visibilizar las relaciones variadas y multidireccionales entre estos.', innovador:'Red de conceptos interactiva', desc:'Es una visualización web en forma de malla donde cada concepto del marco teórico es un nodo conectado a los demás mediante hilos de relación. Al mover uno, toda la red reacciona y al hacer clic en él, aparece una descripción breve del concepto y sus conexiones con los demás.' },
  { fase:'f1', cliche:'Informe diagnóstico', porque:'Es un producto textual diagramado con los gráficos técnicos que incluye los hallazgos y el análisis sobre los resultados, tendencias y patrones identificados en los talleres. No tiene capa visual y su alcance rara vez supera el momento de la sustentación.', innovador:'Cartografía emocional', desc:'Una experiencia web donde los datos del diagnóstico se presentan como un paisaje ilustrado navegable. Cada zona del territorio representa una dimensión emocional del burnout, de la que emergen los datos, los patrones y los testimonios de los participantes desde el propio terreno.' },
  { fase:'f1', cliche:'Álbum fotográfico de registro del proceso', porque:'Las memorias fotográficas del proceso son tomas que evidencian la asistencia a los talleres y la interacción llevada por el guía de la experiencia. Aunque son un registro documental valioso y aportan información analítica al proyecto, son poco atractivas como pieza individual.', innovador:'Galería de silencios', desc:'Es una galería web donde cada fotografía de las sesiones va acompañada del audio ambiente del momento en que fue tomada. Al ver la imagen, el visitante también escucha el silencio, la tensión o la emoción que la rodea, convirtiendo su lectura en una experiencia sensorial.' },
  
  { fase:'f2', cliche:'Guion narrativo', porque:'Es un documento de texto con estructura lineal (introducción, desarrollo, desenlace) que no propone nada más que la literalidad en que la historia será construida. En este sentido, no refleja nuevas propuestas para la experimentación o la narrativa.', innovador:'Portal de historias', desc:'Es una página web donde el universo de la historia se explora a través de sus personajes. Al hacer clic en cada uno, se despliega una explicación sobre su narrativa. La página incluye una animación que cuenta la historia del proyecto de forma simple, sin leer el guion completo.' },
  { fase:'f2', cliche:'Portafolio de proceso', porque:'Es una recopilación cronológica del moodboard, los bocetos y las versiones finales del sistema de diseño y arte de la pieza editorial. A pesar de que documenta las decisiones tomadas, usualmente carece de mayor personalidad y carga justificante sobre el pensamiento aplicado.', innovador:'Decisiones vivas', desc:'Es una experiencia web donde el visitante revive los momentos del proceso de diseño desde adentro. En cada punto clave, se le presentan las opciones que se consideraron y debe elegir una, para después comparar con la decisión real, revisando y entendiendo por qué se tomó.' },
  { fase:'f2', cliche:'Paquete de ilustraciones y animaciones 2D', porque:'Son los recursos diseñados para la integración del sistema de Realidad Aumentada, y por si solos no son más que piezas artísticas estándar. No generan un impacto mayor al del atractivo de su aspecto ni una resonancia emocional sostenida.', innovador:'Colección de objetos', desc:'Son los personajes e ilustraciones del proyecto que se convierten en una línea de souvenirs físicos compuesta por objetos como stickers, pines o libretas. Estos elementos visuales también pueden traducirse a versiones tridimensionales como arttoys o impresiones 3d.' },
  { fase:'f2', cliche:'Maqueta digital del libro ilustrado', porque:'Es una pieza editorial que por lo general tiene una narrativa lineal, ilustraciones grandes y un formato de escritura tipográfica único de inicio a fin. No existe intervención conceptual sobre su estructura, por lo que es un objeto estético sin propuesta diferencial de lectura.', innovador:'Libro web de lectura ramificada', desc:'Una versión web del libro con historia ramificada donde el lector toma decisiones que determinan el camino narrativo que sigue. Los diálogos pueden activarse como audio con voces generadas por IA, convirtiendo la lectura en una experiencia de audiolibro interactivo.' },
  { fase:'f2', cliche:'Prototipo de libro ilustrado impreso con Realidad Aumentada', porque:'Es la pieza final, que funciona como un reproductor de contenido: el usuario escanea una página y ve una animación encima. Aunque posee un efecto tecnológico interesante y un concepto poderoso, con el tiempo ha pasado a ser algo común y poco emocionante.', innovador:'Libro impreso de lectura ramificada RA', desc:'El libro impreso comparte la misma estructura narrativa ramificada de la versión web: en ciertas páginas el lector encuentra decisiones que lo redirigen hacia distintas secciones físicas del libro. La capa de Realidad Aumentada se activa sobre las ilustraciones del camino elegido.' },
  
  { fase:'f3', cliche:'Informe cuantitativo', porque:'Es un producto textual diagramado con los gráficos extraidos del cuestionario tipo Likert y el análisis de los resultados en relación con la incidencia del prototipo en la introspección, resonancia y reflexión de los participantes. No hace visible el impacto de la experiencia.', innovador:'Escenario de resultados', desc:'Es una visualización web donde los resultados del cuestionario se presentan con los personajes del libro en escenas ilustradas. Los porcentajes se leen en la composición, gestos y escenarios de los personajes, que hacen comentarios sobre los resultados.' },
  { fase:'f3', cliche:'Informe cualitativo', porque:'Es un documento textual con el análisis cualitativo de las entrevistas semiestructuradas por categorías temáticas, citas y codificación de respuestas. Es riguroso, pero no es precisamente conmovedor por sí mismo.', innovador:'Panel de testimonios', desc:'Es una página web con un escenario ilustrado donde los participantes están representados como personajes animados seleccionables. Al hacer clic en cada uno, su testimonio es presentado de forma animada. Esta propuesta puede vincularse con el producto anterior.' },
  { fase:'f3', cliche:'Video documental de validación', porque:'Es el video de evidencia que captura a los participantes usando el prototipo y comentando en cámara frente al investigador. Al saber que los filman, los participantes racionalizan, se corrigen y se censuran, produciendo una versión modulada de su experiencia real.', innovador:'Observatorio de lectores', desc:'Es un video ensayo de observación pura, sin entrevistas ni preguntas. La cámara registra lo que hace el cuerpo del lector mientras experimenta el libro: el comportamiento de sus manos, sus microexpresiones, su ritmo de lectura y los momentos de pausa.' },
  { fase:'f3', cliche:'Informe final de validación', porque:'Es un documento de texto con conclusiones y recomendaciones técnicas para futuras iteraciones. Es poco atractivo visualmente y no es muy presentable, por lo que su utilidad real queda restringida al momento de la sustentación.', innovador:'Prototipo intervenido', desc:'Es un ejemplar impreso del libro que funciona como documento de aprendizaje. Sobre las páginas se anotan las observaciones, correcciones y propuestas de mejora identificadas durante la validación, haciendo tangibles y concretas las decisiones para la siguiente iteración.' },
];

const faseLabel = { f1:'Fase 1 — Cartografía', f2:'Fase 2 — Prototipo', f3:'Fase 3 — Validación' };

function renderTable(){
  const tbody = document.getElementById('match-body');
  tbody.innerHTML = '';
  let lastFase = '';
  MATCH.forEach(m=>{
    if(m.fase!==lastFase){
      const hr = document.createElement('tr');
      hr.className='phase-header';
      hr.innerHTML=`<td colspan="4"><span class="phase-label ${m.fase}">${faseLabel[m.fase]}</span></td>`;
      tbody.appendChild(hr);
      lastFase=m.fase;
    }
    const tr=document.createElement('tr');
    tr.dataset.fase=m.fase;
    tr.innerHTML=`<td>${m.cliche}</td><td>${m.porque}</td><td class="${m.fase}">${m.innovador}</td><td>${m.desc}</td>`;
    tbody.appendChild(tr);
  });
}

renderTable();
</script>
</body>
</html>







