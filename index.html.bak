<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sobre lo que no digo</title>
  <meta name="description" content="Diseño de un ecosistema editorial phygital que utiliza la Realidad Aumentada como vehículo de decodificación del burnout en jóvenes universitarios.">
  <link rel="stylesheet" href="css/style.css">
  <style>
    .general-obj {
      background: var(--bg2); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 40px;
      margin-bottom: 40px; position: relative; overflow: hidden;
    }
    .general-obj::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, var(--gold), transparent);
    }
    .general-obj-label {
      font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase;
      color: var(--gold); font-weight: 500; margin-bottom: 16px;
    }
    .general-obj p {
      font-family: var(--font-display);
      font-size: clamp(18px, 2.5vw, 24px);
      font-weight: 300; line-height: 1.6; color: var(--text);
    }
    .phase-tag {
      display: inline-block; padding: 3px 10px; border-radius: 100px;
      font-size: 10px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase;
      margin-bottom: 10px;
    }
    .phase-1 .phase-tag { background: rgba(200,169,110,0.12); color: var(--gold); }
    .phase-2 .phase-tag { background: rgba(124,156,191,0.12); color: var(--blue); }
    .phase-3 .phase-tag { background: rgba(122,173,138,0.12); color: var(--green); }
    .phase-4 .phase-tag { background: rgba(184,122,122,0.12); color: var(--rose); }
    .phase-1 { border-color: rgba(200,169,110,0.15); }
    .phase-2 { border-color: rgba(124,156,191,0.15); }
    .phase-3 { border-color: rgba(122,173,138,0.15); }
    .phase-4 { border-color: rgba(184,122,122,0.15); }
    .obj-card.phase-1:hover { border-color: rgba(200,169,110,0.35); }
    .obj-card.phase-2:hover { border-color: rgba(124,156,191,0.35); }
    .obj-card.phase-3:hover { border-color: rgba(122,173,138,0.35); }
    .obj-card.phase-4:hover { border-color: rgba(184,122,122,0.35); }
    .obj-card.phase-1 h4 { color: var(--gold); }
    .obj-card.phase-2 h4 { color: var(--blue); }
    .obj-card.phase-3 h4 { color: var(--green); }
    .obj-card.phase-4 h4 { color: var(--rose); }

    .hero-quote {
      font-family: var(--font-display);
      font-size: clamp(16px, 2vw, 20px);
      font-style: italic; color: var(--muted2);
      max-width: 600px; margin: 0 auto 50px;
      line-height: 1.7;
    }
    .hero-line {
      width: 60px; height: 1px;
      background: var(--gold); margin: 0 auto 24px; opacity: 0.5;
    }
    .cta-group { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

    /* Gantt */
    .gantt-obj-row td.obj-tag { color: var(--gold); font-size: 11px; font-weight: 600; }
    .gantt-obj-row-2 td.obj-tag { color: var(--blue); }
    .gantt-obj-row-3 td.obj-tag { color: var(--green); }
    .gantt-obj-row-4 td.obj-tag { color: var(--rose); }
    .gantt-table tbody tr { cursor: pointer; transition: background 0.2s; }
    .gantt-table tbody tr:hover { background: rgba(255,255,255,0.03); }
    .gantt-table tbody tr.done .act { text-decoration: line-through; opacity: 0.5; color: var(--muted); }
    .gantt-table tbody tr.done .dot { opacity: 0.2; }
    .gantt-table tbody tr.done .obj-tag { opacity: 0.5; }

    /* Section with background */
    .section-alt { background: var(--bg2); }
    .section-alt .section { padding-top: 80px; padding-bottom: 80px; }
  </style>
</head>
<body>

<!-- NAV -->
<nav>
  <a class="nav-brand" href="index.html"><em>Sobre lo que no digo</em></a>
  <div class="nav-links">
    <div class="nav-item">
      <button class="nav-link">
        Productos
        <svg viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 1l4 4 4-4"/></svg>
      </button>
      <div class="nav-dropdown">
        <a href="cadena-valor.html">Cadena de valor</a>
        <a href="match-creativo.html">Match creativo</a>
        <a href="lluvia-ideas.html">Lluvia de ideas</a>
      </div>
    </div>
    <div class="nav-item">
      <button class="nav-link">
        Instrumentos
        <svg viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 1l4 4 4-4"/></svg>
      </button>
      <div class="nav-dropdown">
        <a href="instrumentos/cdps/infografia.html">CDPS</a>
      </div>
    </div>
  </div>
</nav>

<!-- HERO -->
<div class="page">
  <div class="hero">
    <div class="hero-tag">Investigación · Creación · Diseño Gráfico</div>
    <h1><em>Sobre lo que no digo</em></h1>
    <div class="hero-line"></div>
    <p class="hero-quote">
      "Diseño de un ecosistema editorial phygital que utiliza la Realidad Aumentada como vehículo de decodificación"
    </p>
    <p class="hero-desc">
      Un proyecto de grado que explora el burnout silenciado en jóvenes universitarios a través de una experiencia editorial que combina libro impreso y Realidad Aumentada.
    </p>
  </div>

  <!-- FICHA -->
  <div class="divider"></div>
  <div class="section">
    <div class="section-label">Información general</div>
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px,1fr)); gap:20px; margin-top:8px;">
      <div class="card" style="padding:24px;">
        <p style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:8px;">Estudiante</p>
        <p style="font-size:15px;font-family:var(--font-display);">Shamuel Woodcock Salomón</p>
      </div>
      <div class="card" style="padding:24px;">
        <p style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:8px;">Programa</p>
        <p style="font-size:15px;font-family:var(--font-display);">Diseño Gráfico</p>
      </div>
      <div class="card" style="padding:24px;">
        <p style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:8px;">Institución</p>
        <p style="font-size:15px;font-family:var(--font-display);">Universidad CESMAG</p>
      </div>
      <div class="card" style="padding:24px;">
        <p style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:8px;">Año</p>
        <p style="font-size:15px;font-family:var(--font-display);">2025 – 2026</p>
      </div>
    </div>
  </div>

  <!-- DISEÑO METODOLÓGICO -->
  <div class="divider"></div>
  <div class="section" id="metodologia">
    <div class="section-label">Diseño metodológico</div>
    <div class="section-title">Objetivo general</div>

    <div class="general-obj">
      <div class="general-obj-label">Objetivo general del proyecto</div>
      <p>Diseñar una experiencia editorial phygital con Realidad Aumentada que fomente la introspección frente al burnout en jóvenes universitarios de 18 a 25 años en San Juan de Pasto.</p>
    </div>

    <div class="section-title">Objetivos específicos</div>
    <div class="obj-grid">

      <div class="obj-card phase-1">
        <div class="phase-tag">Objetivo 1</div>
        <div class="obj-number">01</div>
        <h4>Fase 1 — Cartografía diagnóstica</h4>
        <p>Identificar patrones de detonantes, dinámicas y consecuencias emocionales de la hiperexigencia autoimpuesta y el perfeccionismo obsesivo.</p>
        <div class="obj-sub">
          <h5>Actividades</h5>
          <ul class="obj-list">
            <li>Diseñar la guía de preguntas y el protocolo de los grupos focales.</li>
            <li>Realizar los grupos focales con jóvenes universitarios.</li>
            <li>Analizar los resultados e identificar patrones emergentes.</li>
            <li>Consolidar un informe diagnóstico con los hallazgos.</li>
          </ul>
          <h5 style="margin-top:14px;">Instrumentos</h5>
          <ul class="obj-list">
            <li>Grupos focales</li>
            <li>Diario de campo del investigador</li>
            <li>Observación participante con registro audiovisual</li>
          </ul>
          <h5 style="margin-top:14px;">Productos</h5>
          <ul class="obj-list">
            <li>Informe diagnóstico: detonantes, dinámicas y consecuencias</li>
            <li>Ensayo interpretativo: silencios y tensiones observadas</li>
            <li>Cápsulas testimoniales temáticas</li>
          </ul>
        </div>
      </div>

      <div class="obj-card phase-2">
        <div class="phase-tag">Objetivo 2</div>
        <div class="obj-number">02</div>
        <h4>Fase 2 — Tejido narrativo</h4>
        <p>Explorar las vivencias silenciadas de jóvenes universitarios relacionadas con el burnout, para extraer conceptos narrativos y metafóricos.</p>
        <div class="obj-sub">
          <h5>Actividades</h5>
          <ul class="obj-list">
            <li>Diseñar el material y el protocolo de los talleres de co-creación.</li>
            <li>Realizar los talleres de co-creación con jóvenes universitarios.</li>
            <li>Analizar los hallazgos y cruzarlos con el informe diagnóstico.</li>
            <li>Elaborar el sistema narrativo y metafórico.</li>
          </ul>
          <h5 style="margin-top:14px;">Instrumentos</h5>
          <ul class="obj-list">
            <li>Taller de co-creación</li>
            <li>Diario de campo del investigador</li>
            <li>Matriz de triangulación de hallazgos</li>
          </ul>
          <h5 style="margin-top:14px;">Productos</h5>
          <ul class="obj-list">
            <li>Piezas de co-creación de los participantes</li>
            <li>Crónica audiovisual del proceso</li>
            <li>Guion narrativo y metafórico</li>
          </ul>
        </div>
      </div>

      <div class="obj-card phase-3">
        <div class="phase-tag">Objetivo 3</div>
        <div class="obj-number">03</div>
        <h4>Fase 3 — Creación editorial</h4>
        <p>Diseñar un prototipo editorial phygital que articule un libro impreso con Realidad Aumentada, para despertar resonancia emocional frente al burnout.</p>
        <div class="obj-sub">
          <h5>Actividades</h5>
          <ul class="obj-list">
            <li>Diseñar el sistema visual, tipográfico e ilustrativo del libro.</li>
            <li>Producir las ilustraciones y la maquetación del libro impreso.</li>
            <li>Desarrollar la capa de Realidad Aumentada.</li>
            <li>Ensamblar el prototipo editorial phygital.</li>
          </ul>
          <h5 style="margin-top:14px;">Instrumentos</h5>
          <ul class="obj-list">
            <li>Moodboard</li>
            <li>Bocetación y Storyboard</li>
            <li>Prototipado</li>
          </ul>
          <h5 style="margin-top:14px;">Productos</h5>
          <ul class="obj-list">
            <li>Art book del proyecto</li>
            <li>Libro ilustrado impreso</li>
            <li>Sistema de animaciones y paisaje sonoro de RA</li>
            <li>Prototipo phygital con aplicación móvil de RA</li>
          </ul>
        </div>
      </div>

      <div class="obj-card phase-4">
        <div class="phase-tag">Objetivo 4</div>
        <div class="obj-number">04</div>
        <h4>Fase 4 — Validación</h4>
        <p>Validar la experiencia del público objetivo con el prototipo, para determinar su incidencia en la introspección, resonancia emocional y reflexión crítica frente al burnout.</p>
        <div class="obj-sub">
          <h5>Actividades</h5>
          <ul class="obj-list">
            <li>Diseñar el cuestionario y el protocolo de las sesiones de validación.</li>
            <li>Realizar las sesiones de validación y las entrevistas.</li>
            <li>Analizar los resultados de la validación.</li>
            <li>Formular conclusiones y recomendaciones.</li>
          </ul>
          <h5 style="margin-top:14px;">Instrumentos</h5>
          <ul class="obj-list">
            <li>Cuestionario tipo Likert</li>
            <li>Entrevista semiestructurada</li>
            <li>Observatorio de lectores (video ensayo)</li>
          </ul>
          <h5 style="margin-top:14px;">Productos</h5>
          <ul class="obj-list">
            <li>Escenario de resultados animado</li>
            <li>Panel de testimonios</li>
            <li>Prototipo intervenido</li>
          </ul>
        </div>
      </div>

    </div>
  </div>

  <!-- CRONOGRAMA -->
  <div class="divider"></div>
  <div class="section" id="cronograma">
    <div class="section-label">Cronograma</div>
    <div class="section-title">Cronograma de actividades — 2026 <span style="font-size:12px; font-weight:normal; color:var(--muted); margin-left:12px;">(Haz clic en las filas para marcar tu progreso)</span></div>
    <div class="gantt-wrap">
      <table class="gantt-table">
        <thead>
          <tr>
            <th style="min-width:90px;">Fase</th>
            <th style="min-width:260px;">Actividad</th>
            <th class="week" style="min-width:28px;font-size:10px;">30/03</th>
            <th class="week" style="min-width:28px;font-size:10px;">06/04</th>
            <th class="week" style="min-width:28px;font-size:10px;">13/04</th>
            <th class="week" style="min-width:28px;font-size:10px;">20/04</th>
            <th class="week" style="min-width:28px;font-size:10px;">27/04</th>
            <th class="week" style="min-width:28px;font-size:10px;">04/05</th>
            <th class="week" style="min-width:28px;font-size:10px;">11/05</th>
            <th class="week" style="min-width:28px;font-size:10px;">18/05</th>
            <th class="week" style="min-width:28px;font-size:10px;">25/05</th>
            <th class="week" style="min-width:28px;font-size:10px;">01/06</th>
            <th class="week" style="min-width:28px;font-size:10px;">08/06</th>
            <th class="week" style="min-width:28px;font-size:10px;">15/06</th>
            <th class="week" style="min-width:28px;font-size:10px;">22/06</th>
            <th class="week" style="min-width:28px;font-size:10px;">29/06</th>
            <th class="week" style="min-width:28px;font-size:10px;">06/07</th>
            <th class="week" style="min-width:28px;font-size:10px;">13/07</th>
            <th class="week" style="min-width:28px;font-size:10px;">20/07</th>
            <th class="week" style="min-width:28px;font-size:10px;">27/07</th>
            <th class="week" style="min-width:28px;font-size:10px;">03/08</th>
            <th class="week" style="min-width:28px;font-size:10px;">10/08</th>
            <th class="week" style="min-width:28px;font-size:10px;">17/08</th>
            <th class="week" style="min-width:28px;font-size:10px;">24/08</th>
            <th class="week" style="min-width:28px;font-size:10px;">31/08</th>
            <th class="week" style="min-width:28px;font-size:10px;">07/09</th>
            <th class="week" style="min-width:28px;font-size:10px;">14/09</th>
            <th class="week" style="min-width:28px;font-size:10px;">21/09</th>
            <th class="week" style="min-width:28px;font-size:10px;">28/09</th>
            <th class="week" style="min-width:28px;font-size:10px;">05/10</th>
            <th class="week" style="min-width:28px;font-size:10px;">12/10</th>
            <th class="week" style="min-width:28px;font-size:10px;">19/10</th>
            <th class="week" style="min-width:28px;font-size:10px;">26/10</th>
            <th class="week" style="min-width:28px;font-size:10px;">02/11</th>
            <th class="week" style="min-width:28px;font-size:10px;">09/11</th>
            <th class="week" style="min-width:28px;font-size:10px;">16/11</th>
            <th class="week" style="min-width:28px;font-size:10px;">23/11</th>
          </tr>
        </thead>
        <tbody id="gantt-body"></tbody>
      </table>
    </div>
  </div>

  <!-- FOOTER -->
  <div class="divider"></div>
  <footer style="padding:40px; text-align:center;">
    <p style="font-size:13px;color:var(--muted);">Sobre lo que no digo · Universidad CESMAG · Diseño Gráfico · 2026</p>
  </footer>
</div>

<script>
const ganttData = [
  { fase: 'Objetivo 1', cls: 'f1', txt: 'Diseñar la guía de preguntas y el protocolo de los grupos focales.', weeks: [1] },
  { fase: '', cls: 'f1', txt: 'Realizar los grupos focales con jóvenes universitarios.', weeks: [2,3,4] },
  { fase: '', cls: 'f1', txt: 'Analizar los resultados e identificar patrones emergentes.', weeks: [5,6] },
  { fase: '', cls: 'f1', txt: 'Consolidar un informe diagnóstico con los hallazgos.', weeks: [7,8] },
  { fase: 'Objetivo 2', cls: 'f2', txt: 'Diseñar el material y el protocolo de los talleres de co-creación.', weeks: [9,10] },
  { fase: '', cls: 'f2', txt: 'Realizar los talleres de co-creación con jóvenes universitarios.', weeks: [11,12,13] },
  { fase: '', cls: 'f2', txt: 'Analizar los hallazgos y cruzarlos con el informe diagnóstico.', weeks: [13,14] },
  { fase: '', cls: 'f2', txt: 'Elaborar el sistema narrativo y metafórico.', weeks: [15,16,17] },
  { fase: 'Objetivo 3', cls: 'f3', txt: 'Diseñar el sistema visual, tipográfico e ilustrativo del libro.', weeks: [18,19,20] },
  { fase: '', cls: 'f3', txt: 'Producir las ilustraciones y la maquetación del libro impreso.', weeks: [21,22,23] },
  { fase: '', cls: 'f3', txt: 'Desarrollar la capa de Realidad Aumentada: animaciones y paisaje sonoro.', weeks: [23,24,25,26,27] },
  { fase: '', cls: 'f3', txt: 'Ensamblar el prototipo editorial phygital.', weeks: [27,28,29] },
  { fase: 'Objetivo 4', cls: 'f4', txt: 'Diseñar el cuestionario y el protocolo de las sesiones de validación.', weeks: [30,31] },
  { fase: '', cls: 'f4', txt: 'Realizar las sesiones de validación y las entrevistas.', weeks: [32] },
  { fase: '', cls: 'f4', txt: 'Analizar los resultados de la validación.', weeks: [32,33] },
  { fase: '', cls: 'f4', txt: 'Formular conclusiones y recomendaciones.', weeks: [34,35] },
];

const TOTAL_WEEKS = 35;
const colorMap = { f1: '#c8a96e', f2: '#7c9cbf', f3: '#7aad8a', f4: '#b87a7a' };
const tbody = document.getElementById('gantt-body');
const savedGantt = JSON.parse(localStorage.getItem('gantt_state')) || {};

ganttData.forEach((row, i) => {
  const tr = document.createElement('tr');
  if (savedGantt[i]) tr.classList.add('done');
  
  tr.addEventListener('click', () => {
    tr.classList.toggle('done');
    savedGantt[i] = tr.classList.contains('done');
    localStorage.setItem('gantt_state', JSON.stringify(savedGantt));
  });

  const faseCell = row.fase
    ? `<td class="obj-tag" style="color:${colorMap[row.cls]};font-size:11px;font-weight:600;white-space:nowrap;">${row.fase}</td>`
    : `<td></td>`;
  let weekCells = '';
  for (let w = 1; w <= TOTAL_WEEKS; w++) {
    if (row.weeks.includes(w)) {
      weekCells += `<td class="week"><div class="dot ${row.cls}"></div></td>`;
    } else {
      weekCells += `<td class="week"></td>`;
    }
  }
  tr.innerHTML = faseCell + `<td class="act">${row.txt}</td>` + weekCells;
  tbody.appendChild(tr);
});
</script>
</body>
</html>







